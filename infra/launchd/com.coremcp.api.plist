<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.coremcp.api</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/env</string>
    <string>bash</string>
    <string>-lc</string>
    <string>export PATH="/opt/homebrew/bin:/usr/local/bin:$HOME/.local/bin:$PATH"; cd "$HOME/project_202605/CoreMCP/apps/api" &amp;&amp; uv run uvicorn coremcp.main:app --host 127.0.0.1 --port 8787</string>
