<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.coremcp.web</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/env</string>
    <string>bash</string>
    <string>-lc</string>
    <string>cd "$HOME/project_202605/CoreMCP/apps/web" &amp;&amp; pnpm start --hostname 127.0.0.1 --port 3000</string>
  </array>
  <key>RunAtLoad</key>
  <false/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>$HOME/.coremcp/logs/web.log</string>
  <key>StandardErrorPath</key>
  <string>$HOME/.coremcp/logs/web.err.log</string>
</dict>
</plist>
